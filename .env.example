# Web/iOS simulator on the same computer:
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000

# Firebase Web SDK configuration. Copy the public values from your Firebase app.
# Do not place Firebase Admin private keys in the Expo project.
EXPO_PUBLIC_FIREBASE_API_KEY=YOUR_FIREBASE_WEB_API_KEY
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
EXPO_PUBLIC_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID

# Android emulator usually needs:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8000

# A physical device needs the computer's LAN IP, for example:
# EXPO_PUBLIC_API_URL=http://192.168.1.50:8000